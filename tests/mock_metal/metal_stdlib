// A tiny stand-in for <metal_stdlib> so that MSL produced by atlan::glsl can be compiled and executed as ordinary C++
// with Clang. It models only what the translator emits. Vectors are Clang ext_vector_type (same swizzle syntax and
// scalar-vector arithmetic as MSL); constructors are routed through variadic helpers that flatten their arguments.
#pragma once
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <functional>

namespace metal {
typedef float float2 __attribute__((ext_vector_type(2)));
typedef float float3 __attribute__((ext_vector_type(3)));
typedef float float4 __attribute__((ext_vector_type(4)));
typedef int int2 __attribute__((ext_vector_type(2)));
typedef int int3 __attribute__((ext_vector_type(3)));
typedef int int4 __attribute__((ext_vector_type(4)));
typedef int bool2 __attribute__((ext_vector_type(2)));  // comparison results are int vectors in Clang
typedef int bool3 __attribute__((ext_vector_type(3)));
typedef int bool4 __attribute__((ext_vector_type(4)));

namespace detail {
template <typename T> struct lanes { static constexpr int n = 1; static constexpr bool vec = false; };
template <> struct lanes<float2> { static constexpr int n = 2; static constexpr bool vec = true; };
template <> struct lanes<float3> { static constexpr int n = 3; static constexpr bool vec = true; };
template <> struct lanes<float4> { static constexpr int n = 4; static constexpr bool vec = true; };
template <> struct lanes<int2> { static constexpr int n = 2; static constexpr bool vec = true; };
template <> struct lanes<int3> { static constexpr int n = 3; static constexpr bool vec = true; };
template <> struct lanes<int4> { static constexpr int n = 4; static constexpr bool vec = true; };
template <typename T> struct scalar_of { using type = T; };
template <> struct scalar_of<float2> { using type = float; };
template <> struct scalar_of<float3> { using type = float; };
template <> struct scalar_of<float4> { using type = float; };
template <> struct scalar_of<int2> { using type = int; };
template <> struct scalar_of<int3> { using type = int; };
template <> struct scalar_of<int4> { using type = int; };

template <typename V, int N> struct filler {
    V v{};
    int k = 0;
    template <typename S> void put(S s) { if (k < N) v[k++] = static_cast<typename scalar_of<V>::type>(s); }
    template <typename S> void add(S s) {
        if constexpr (lanes<S>::vec) { for (int i = 0; i < lanes<S>::n && k < N; ++i) put(s[i]); }
        else put(s);
    }
};
template <typename V, typename... A> V make(A... a) {
    constexpr int N = lanes<V>::n;
    filler<V, N> f;
    (f.add(a), ...);
    if constexpr (sizeof...(A) == 1) {
        if (f.k == 1) for (int i = 1; i < N; ++i) f.v[i] = f.v[0];  // scalar broadcast
    }
    return f.v;
}
}

template <typename V, int N> struct matrix {
    V c[N];
    matrix() : c{} {}
    template <typename... A> matrix(V first, A... rest) : c{first, rest...} {}
    V& operator[](int i) { return c[i]; }
    const V& operator[](int i) const { return c[i]; }
};
typedef matrix<float2, 2> float2x2;
typedef matrix<float3, 3> float3x3;
typedef matrix<float4, 4> float4x4;

template <typename V, int N> V operator*(const matrix<V, N>& m, V v) {
    V r{};
    for (int i = 0; i < N; ++i) r += m.c[i] * v[i];
    return r;
}
template <typename V, int N> V operator*(V v, const matrix<V, N>& m) {
    V r{};
    for (int j = 0; j < N; ++j) { float s = 0; for (int i = 0; i < N; ++i) s += v[i] * m.c[j][i]; r[j] = s; }
    return r;
}
template <typename V, int N> matrix<V, N> operator*(const matrix<V, N>& a, const matrix<V, N>& b) {
    matrix<V, N> r;
    for (int j = 0; j < N; ++j) r.c[j] = a * b.c[j];
    return r;
}
template <typename V, int N> matrix<V, N> operator*(const matrix<V, N>& a, float s) { matrix<V, N> r = a; for (auto& c : r.c) c *= s; return r; }
template <typename V, int N> matrix<V, N> operator*(float s, const matrix<V, N>& a) { return a * s; }

// ---- math
template <typename T> inline T abs(T x) { return __builtin_elementwise_abs(x); }
template <typename T> inline T floor(T x) { return __builtin_elementwise_floor(x); }
template <typename T> inline T ceil(T x) { return __builtin_elementwise_ceil(x); }
template <typename T> inline T sqrt(T x) { return __builtin_elementwise_sqrt(x); }
template <typename T> inline T rsqrt(T x) { return T(1) / __builtin_elementwise_sqrt(x); }
template <typename T> inline T sin(T x) { return __builtin_elementwise_sin(x); }
template <typename T> inline T cos(T x) { return __builtin_elementwise_cos(x); }
template <typename T> inline T tan(T x) { return __builtin_elementwise_tan(x); }
template <typename T> inline T asin(T x) { return __builtin_elementwise_asin(x); }
template <typename T> inline T acos(T x) { return __builtin_elementwise_acos(x); }
template <typename T> inline T atan2(T y, T x) { return __builtin_elementwise_atan2(y, x); }
template <typename T> inline T atan(T x) { return __builtin_elementwise_atan(x); }
template <typename T> inline T exp(T x) { return __builtin_elementwise_exp(x); }
template <typename T> inline T exp2(T x) { return __builtin_elementwise_exp2(x); }
template <typename T> inline T log(T x) { return __builtin_elementwise_log(x); }
template <typename T> inline T log2(T x) { return __builtin_elementwise_log2(x); }
template <typename T> inline T pow(T x, T y) { return __builtin_elementwise_pow(x, y); }
template <typename T> inline T max(T a, T b) { return __builtin_elementwise_max(a, b); }
template <typename T> inline T min(T a, T b) { return __builtin_elementwise_min(a, b); }
template <typename T> inline T clamp(T x, T lo, T hi) { return __builtin_elementwise_min(__builtin_elementwise_max(x, lo), hi); }
template <typename T> inline T mix(T x, T y, T a) { return x + (y - x) * a; }
template <typename T> inline T fract(T x) { return x - __builtin_elementwise_floor(x); }
template <typename T> inline T sign(T x) {
    if constexpr (detail::lanes<T>::vec) {
        T r{};
        for (int i = 0; i < detail::lanes<T>::n; ++i) r[i] = x[i] > 0 ? 1 : (x[i] < 0 ? -1 : 0);
        return r;
    } else {
        return x > 0 ? 1 : (x < 0 ? -1 : 0);
    }
}
template <typename T> inline T step(T edge, T x) {
    if constexpr (detail::lanes<T>::vec) {
        T r{};
        for (int i = 0; i < detail::lanes<T>::n; ++i) r[i] = x[i] < edge[i] ? 0 : 1;
        return r;
    } else {
        return x < edge ? 0 : 1;
    }
}
template <typename T> inline T smoothstep(T e0, T e1, T x) {
    T t = clamp((x - e0) / (e1 - e0), T(0), T(1));
    return t * t * (T(3) - T(2) * t);
}
template <typename T> inline float dot(T a, T b) {
    if constexpr (detail::lanes<T>::vec) { float s = 0; for (int i = 0; i < detail::lanes<T>::n; ++i) s += a[i] * b[i]; return s; }
    else return a * b;
}
template <typename T> inline float length(T a) { return std::sqrt(dot(a, a)); }
template <typename T> inline float distance(T a, T b) { return length(a - b); }
template <typename T> inline T normalize(T a) { return a / length(a); }
inline float3 cross(float3 a, float3 b) { return float3{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}; }
template <typename T> inline T reflect(T i, T n) { return i - n * (2 * dot(n, i)); }
template <typename T> inline bool all(T v) { for (int i = 0; i < detail::lanes<T>::n; ++i) if (!v[i]) return false; return true; }
template <typename T> inline bool any(T v) { for (int i = 0; i < detail::lanes<T>::n; ++i) if (v[i]) return true; return false; }

// ---- textures
struct sampler {};
struct level_arg { float v; };
struct bias_arg { float v; };
inline level_arg level(float v) { return {v}; }
inline bias_arg bias(float v) { return {v}; }
template <typename T> struct texture2d {
    std::function<float4(float2)> fetch = [](float2) { return float4{0, 0, 0, 1}; };
    float4 sample(sampler, float2 uv) const { return fetch(uv); }
    float4 sample(sampler, float2 uv, level_arg) const { return fetch(uv); }
    float4 sample(sampler, float2 uv, bias_arg) const { return fetch(uv); }
};
inline bool g_discarded = false;
inline void discard_fragment() { g_discarded = true; }
}

using namespace metal;
// Address spaces and function qualifiers have no meaning on the host.
#define constant
#define thread
#define vertex
#define fragment
// Constructors are spelled like calls in MSL; route them through the flattening helpers.
#define float2(...) metal::detail::make<metal::float2>(__VA_ARGS__)
#define float3(...) metal::detail::make<metal::float3>(__VA_ARGS__)
#define float4(...) metal::detail::make<metal::float4>(__VA_ARGS__)
#define int2(...) metal::detail::make<metal::int2>(__VA_ARGS__)
#define int3(...) metal::detail::make<metal::int3>(__VA_ARGS__)
#define int4(...) metal::detail::make<metal::int4>(__VA_ARGS__)
#pragma clang diagnostic ignored "-Wunknown-attributes"
