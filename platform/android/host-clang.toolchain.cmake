# Cross-compiles for arm64-v8a Android with the host's clang and an NDK's sysroot and runtime libraries, for build
# hosts the NDK ships no compiler for (Linux on arm64). Elsewhere use the NDK's own build/cmake/android.toolchain.cmake.
# -DANDROID_NDK=<ndk> (or $ANDROID_NDK_HOME), optional -DANDROID_PLATFORM_LEVEL=<api> (default 26).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(ANDROID TRUE)
set(ANDROID_ABI arm64-v8a)
if(NOT ANDROID_NDK)
  set(ANDROID_NDK "$ENV{ANDROID_NDK_HOME}")
endif()
if(NOT ANDROID_PLATFORM_LEVEL)
  set(ANDROID_PLATFORM_LEVEL 26)
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ANDROID_NDK ANDROID_PLATFORM_LEVEL)
file(GLOB _atlan_prebuilt LIST_DIRECTORIES true "${ANDROID_NDK}/toolchains/llvm/prebuilt/*")
list(GET _atlan_prebuilt 0 _atlan_prebuilt)
file(GLOB _atlan_resource LIST_DIRECTORIES true "${_atlan_prebuilt}/lib/clang/*")
list(GET _atlan_resource 0 _atlan_resource)
if(NOT EXISTS "${_atlan_prebuilt}/sysroot/usr/include/android/api-level.h")
  message(FATAL_ERROR "no NDK sysroot under ${ANDROID_NDK}")
endif()
set(CMAKE_SYSROOT "${_atlan_prebuilt}/sysroot")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-android${ANDROID_PLATFORM_LEVEL})
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-android${ANDROID_PLATFORM_LEVEL})
# The NDK's compiler-rt builtins and libunwind; libc++ is linked statically like the NDK's c++_static.
set(_atlan_link "-fuse-ld=lld -resource-dir=${_atlan_resource} --rtlib=compiler-rt --unwindlib=libunwind -static-libstdc++")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_atlan_link}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_atlan_link}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_atlan_link}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
